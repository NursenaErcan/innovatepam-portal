generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  submitter
  admin
}

enum IdeaStatus {
  draft
  submitted
  under_review
  accepted
  rejected
}

enum IdeaCategory {
  Technical_Innovation
  Process_Improvement
  Client_Solution
  Other
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  hashedPassword String
  role           UserRole  @default(submitter)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ideas              Idea[]
  evaluationComments EvaluationComment[]
  sessions           Session[]
}

model Idea {
  id                 String              @id @default(uuid())
  title              String
  description        String
  category           IdeaCategory
  customFields       Json?
  status             IdeaStatus          @default(submitted)
  submitter          User                @relation(fields: [submitterId], references: [id])
  submitterId        String
  attachments        Attachment[]
  evaluationComments EvaluationComment[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Attachment {
  id           String   @id @default(uuid())
  idea         Idea     @relation(fields: [ideaId], references: [id])
  ideaId       String
  fileName     String
  storagePath  String
  mimeType     String
  size         Int
  displayOrder Int
  createdAt    DateTime @default(now())

  @@unique([ideaId, displayOrder])
}

model EvaluationComment {
  id        String   @id @default(uuid())
  idea      Idea     @relation(fields: [ideaId], references: [id])
  ideaId    String
  admin     User     @relation(fields: [adminId], references: [id])
  adminId   String
  text      String
  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
